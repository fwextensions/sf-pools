# google generative ai api key for @ai-sdk/google
GOOGLE_GENERATIVE_AI_API_KEY=

# disable build failure on large schedule changes (useful for local development)
# set to "false" to allow large changes without failing the build
FAIL_ON_LARGE_CHANGES=true

# posthog project api key (public — it is shipped to the browser). Leaving it
# empty disables analytics entirely rather than failing.
NEXT_PUBLIC_POSTHOG_KEY=
