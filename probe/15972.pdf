<li class="InfoAdvanced widgetItem fr-view">
	<style>
	/* 1. CONSISTENT TEXT STYLING */
	
	.footer-contact {
		font-family: Arial, Helvetica, sans-serif; font-size: 14px;/* Accessible standard */
		line-height: 1.6; color: #333; margin-top: 9px;
	}
	/* 2. CONTACT LINK STYLING (High Contrast Blue) */
	
	.footer-contact a {
		color: #2A525E !important; text-decoration: underline !important; font-weight: bold;
	}
	/* 3. THE SHADOW RING (Keyboard Focus) */
	
	.footer-contact a:focus {
		/* This "Shadow" ring pierces through most CMS theme locks */
		box-shadow: 0 0 0 4px #e6c200, 0 0 0 8px rgba(255, 255, 255, 0.9) !important; outline: 4px solid transparent !important; background-color: rgba(230, 194, 0, 0.15) !important; border-radius: 2px !important; text-decoration: none !important; position: relative !important; z-index: 10000 !important; display: inline-block !important;
	}
	/* Formatting for the address and phone lines */
	
