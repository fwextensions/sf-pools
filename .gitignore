# data
/data/pdfs/*
!/data/pdfs/.gitkeep
# data/extracted/ is tracked: it caches the model's read of each PDF by hash,
# so a PDF that hasn't changed isn't sent to the model again
#/data/changelog/*
!/data/changelog/.gitkeep
# pdf-manifest.json is intentionally tracked for incremental extraction

